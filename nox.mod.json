{
  "type": "mod",
  "id": "nox.ui",
  "provides": [
    "fr.hactazia.ui",
    "ui"
  ],
  "name": "UI",
  "version": "1.0.0",
  "description": "Core user interface components, layouts, and API for Nox.",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/nox.ui",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/nox.ui/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "constraints": [
    {
      "type": "after",
      "id": "audio"
    }
  ],
  "relations": [
    {
      "id": "audio",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.audio.git"
    },
    {
      "id": "nox.cck",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.cck.git"
    },
    {
      "id": "com.cysharp.unitask",
      "type": "depends",
      "register": "git+https://github.com/Cysharp/UniTask.git?path=src/UniTask/Assets/Plugins/UniTask"
    },
    {
      "id": "com.unity.textmeshpro",
      "type": "depends",
      "register": "upm:3.0.0"
    },
    {
      "id": "com.unity.inputsystem",
      "type": "depends",
      "register": "upm:1.19.0"
    }
  ],
  "entrypoints": {
    "client": [
      "Nox.UI.Runtime.Client",
      "Nox.UI.Runtime.DefaultPagesClient"
    ],
    "main": [
      "Nox.UI.Runtime.Main"
    ],
    "editor": [
      "Nox.UI.Runtime.Editor"
    ]
  }
}